# ==============================================================================
# Enterprise RAG System Configuration Example
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME="Enterprise RAG System"
DEBUG=true
LOG_LEVEL=INFO

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL 16 with pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_rag
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_rag
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# AI Provider Configuration
# Set to 'mock' for 100% offline development, or 'openai' for live API
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=mock

# Mock Adapter Configuration
MOCK_EMBEDDING_DIM=384

# OpenAI Configuration (Only required if provider is set to 'openai')
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# Document Ingestion & Chunking Settings
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# Retrieval & Grounded Generation Thresholds
DEFAULT_TOP_K=5
RRF_K_CONSTANT=60
CONFIDENCE_THRESHOLD=0.65
MAX_GENERATION_TOKENS=1024
TEMPERATURE=0.0
